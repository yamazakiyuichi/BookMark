<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) data extraction rules.
    Controls what is included in cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bookmark_database" />
        <include domain="database" path="bookmark_database-shm" />
        <include domain="database" path="bookmark_database-wal" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bookmark_database" />
        <include domain="database" path="bookmark_database-shm" />
        <include domain="database" path="bookmark_database-wal" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
